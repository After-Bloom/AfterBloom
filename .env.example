NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Hosted symptom matching (Cloudflare Workers AI free tier). Server-only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# App-level encryption of screening answers (32 random bytes, base64). Never change after launch or old answers become unreadable.
ENCRYPTION_KEY=
# Shared secret for scheduled jobs (/api/cron/*)
CRON_SECRET=
# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Demo accounts (remove before real users arrive)
DEMO_PASSWORD=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional text-message reminders (Twilio). Leave empty to turn off. TWILIO_FROM is your Twilio number, e.g. +1415...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Set to whatsapp to send through WhatsApp instead of SMS (needs an approved WhatsApp sender)
TWILIO_CHANNEL=
